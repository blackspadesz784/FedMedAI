# FedMed AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# This file is safe to commit (it has no real secrets).
# .env itself is in .gitignore.

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production-use-a-random-string

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Paths (relative to backend/ directory) ────────────────────────────────────
MODEL_DIR=models
GRADCAM_DIR=gradcam_outputs
UPLOADS_DIR=uploads

# ── Image inference ────────────────────────────────────────────────────────────
IMG_SIZE=224
PREDICTION_THRESHOLD=0.5
MAX_UPLOAD_MB=16

# ── CORS (comma-separated origins, or * for all) ──────────────────────────────
# For production, replace * with your GitHub Pages URL:
# CORS_ORIGINS=https://yourusername.github.io
CORS_ORIGINS=*
